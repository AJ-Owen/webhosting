PAPERLESS_SECRET_KEY=rrsthwyugal4rstamkd1384rsqjulaudh
PAPERLESS_WEBSERVER_WORKERS=2

# --- Authelia SSO (see nginx/ONBOARDING.md) ---
# nginx forwards Authelia's identity as the Remote-User header on
# docs.joshowen.uk; Django maps that to HTTP_REMOTE_USER and logs the user in,
# so no separate Paperless password is needed.
#
# NOTE: Django's RemoteUserBackend auto-creates unknown users. Access to
# docs.joshowen.uk is therefore restricted by name in Authelia's access_control
# (nginx/config/configuration.yml) -- add a user there to grant access.
#
# NOTE: anything that can reach paperless:8000 directly on docker_proxy_network
# can impersonate any user by setting this header. Never publish port 8000.
PAPERLESS_ENABLE_HTTP_REMOTE_USER=true
PAPERLESS_HTTP_REMOTE_USER_HEADER_NAME=HTTP_REMOTE_USER
# Left off deliberately: the API keeps token/basic auth so mobile and script
# clients, which cannot complete an Authelia browser login, still work.
# PAPERLESS_ENABLE_HTTP_REMOTE_USER_API=true
